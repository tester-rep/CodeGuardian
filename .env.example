# CodeGuardian-CLI Environment Configuration
# Copy this file to .env and fill in your real keys
# .env is excluded by .gitignore and will not be committed

# AI Provider API Key
# Supports any OpenAI-compatible endpoint (OpenAI, Azure, local LLM proxies, etc.)
# Set your provider's API key here:
CODEGUARDIAN_API_KEY=your_api_key_here

# Optional: custom base URL for OpenAI-compatible API
# CODEGUARDIAN_BASE_URL=https://api.openai.com/v1
